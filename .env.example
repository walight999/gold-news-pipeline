# Copy to .env for local dev. In Actions these are repo secrets.
LINE_CHANNEL_TOKEN=
LINE_NEWS_TARGET=
LINE_HEALTH_TARGET=
GSHEET_ID=
# GSHEET_CREDS = raw JSON of service-account key (paste single-line JSON)
GSHEET_CREDS=
# Optional — enables FRED-backed actual values in post-release calendar alerts.
# Free signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Optional — Claude Haiku primary classifier+Thai rewrite for LINE cards.
ANTHROPIC_API_KEY=
# Optional — Gemini secondary classifier, used when Claude is unavailable
# (e.g. Anthropic spend cap) before the literal-translation fallback.
# Free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional override for the Gemini model id (default: gemini-2.0-flash).
GEMINI_MODEL=
# Optional — Apify X/Twitter fast-news scraper.
APIFY_TOKEN=
# Optional — off-GAS CHUM News Bot (Cloudflare Worker) delivery target. Both must be
# set or the Telegram news push no-ops (env-gated). URL = the worker base, SECRET =
# the worker's NEWS_WEBHOOK_SECRET.
NEWS_BOT_WEBHOOK_URL=
NEWS_BOT_SECRET=
# Optional — macro-state push to the CHUM alert-bot worker (--mode macro). Both must
# be set or the push no-ops. URL = https://api.justchum.com, SECRET = the alert-bot
# worker's TRADINGVIEW_SECRET (reused as the macro webhook secret).
MACRO_WEBHOOK_URL=
MACRO_WEBHOOK_SECRET=

# --- Social autopost (@tradetongkam): X / Twitter (OAuth 1.0a, Read+Write) ---
# Needed for social_post + the daily-brief tweet_post. Create at developer.x.com.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Daily brief → Notion review page (--mode daily_brief + the post modes) ---
# Notion internal-integration secret + the parent page id the daily pages go under.
# notion.so/my-integrations → share the parent page with the integration.
# UNSET => daily_brief dry-runs (snapshot only); the post modes can't read approvals.
NOTION_TOKEN=
NOTION_BRIEF_PARENT=

# --- Facebook Page auto-publish (--mode fb_post + reel_post) ---
# Long-lived Page access token (pages_manage_posts [+ video for Reels]) + Page id.
# UNSET => FB posting no-ops.
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Video reel render (--mode video_brief) ---
# JSON2Video API key (TTS + subtitles + assembly). UNSET => dry-run (payload only).
JSON2VIDEO_KEY=
# Optional Thai voice id (default th-TH-PremwadeeNeural).
BRIEF_VOICE=
# Optional macro b-roll for the reel. Free key: pexels.com/api. UNSET => cards/gradient.
PEXELS_API_KEY=

# --- Artwork (OPTIONAL/dormant) ---
# The primary artwork flow is manual (gen in ChatGPT web, drop into the Notion page).
# These only enable the auto OpenAI-API path (extra billing). Usually left unset.
OPENAI_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=
